modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "ReturnShield Preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd returnshield-ai; .venv/bin/uvicorn src.api:app --host 127.0.0.1 --port 8000 >/tmp/returnshield-api.log 2>&1 & api_pid=$!; trap 'kill $api_pid 2>/dev/null || true' EXIT; .venv/bin/streamlit run dashboard/app.py --server.address 0.0.0.0 --server.port 8008 --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
waitForPort = 8008

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ReturnShield Preview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true

[[ports]]
localPort = 8008
externalPort = 8008
